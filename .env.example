# Mind — Environment Configuration Reference
# Duplicate this file to .env for local overrides. NEVER commit real secrets to source control.

# Application
APP_NAME=Mind
ENVIRONMENT=development
DEBUG=true
PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
PRODUCT_DISPLAY_NAME=Mind
PRODUCT_TAGLINE="Intelligence for Better Learning"

# Security & Sessions
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars-long
SESSION_COOKIE_NAME=mind_session
SESSION_MAX_AGE_SECONDS=86400
SECURE_COOKIES=false
SAME_SITE=lax
PASSWORD_HASH_ALGORITHM=argon2id

# Database
# For local dev / Docker: postgresql+asyncpg://mind_user:mind_pass@postgres:5432/mind_db
# For test execution: sqlite+aiosqlite:///./mind_test.db
DATABASE_URL=sqlite+aiosqlite:///./mind_dev.db
DATABASE_ECHO=false

# Queue / Redis
REDIS_URL=redis://localhost:6379/0

# Object Storage (dual: local or s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./local_storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=mind-assets
AWS_S3_ENDPOINT_URL=

# AI Provider Gateway
# Options: mock, gemini
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro

# Email / Notifications
# Options: console, mailpit, smtp, resend
EMAIL_BACKEND=console
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=no-reply@mindlearning.local

# Observability
LOG_LEVEL=INFO
SENTRY_DSN=
